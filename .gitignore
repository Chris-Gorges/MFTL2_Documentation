# Build products: the Doxygen manual, the MkDocs site, mkdoxy's XML cache and
# the generated Doxyfiles. Everything under build/ is regenerated by
# build_docs.py / build_mkdocs.py and nothing under it is edited by hand.
/build/

# The documentation toolchain, installed by `python3 build_mkdocs.py` from
# requirements-docs.txt. Private to this repository on purpose: a documentation
# dependency must never be able to change what the library build does.
/.venv-docs/

# Local answer to "where is the library?" -- see mftl_paths.py. Machine
# specific, so it is configured rather than committed.
/mftl-source.txt

# Generated by export_manual.py, and the privacy plugin's download cache.
# The EXPORT itself (prebuilt/) is committed on purpose.
/.mkdocs.export.yml
/.cache/

__pycache__/
*.pyc

.DS_Store
.vscode/
.idea/

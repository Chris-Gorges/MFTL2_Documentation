# ══════════════════════════════════════════════════════════════════════════════
#  MFTL -- Doxygen configuration
#
#  This file lives in the MFTL2_Documentation repository and reads a checkout of
#  the LIBRARY that sits somewhere else, so it carries TWO roots and the
#  distinction is load-bearing:
#
#    @MFTL_DOCS_SOURCE_DIR@  the MFTL library    -- include/, src/, examples/,
#                            tests/ and the measurement document in docs/
#    @MFTL_DOCS_DIR@         this repository     -- doxygen/, pages/, images/
#
#  Both are substituted by CMake's configure_file() on the CMake route and by
#  the same substitution in build_docs.py on the standalone one, so the two
#  routes produce identical output. mftl_paths.py is what decides the first.
# ══════════════════════════════════════════════════════════════════════════════

DOXYFILE_ENCODING      = UTF-8

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "MFTL"
PROJECT_NUMBER         = "@MFTL_VERSION@"
PROJECT_BRIEF          = "MultiFlow Triangulation Library -- distributed-memory triangulated surface meshes for front tracking and IBM CFD"
PROJECT_LOGO           =
PROJECT_ICON           =

OUTPUT_DIRECTORY       = @MFTL_DOCS_OUTPUT_DIR@
CREATE_SUBDIRS         = NO
# Pinned rather than left at SYSTEM (NO on macOS/Windows, YES on Linux): it
# decides the spelling of every compound id and file name, and export_manual.py
# and the site's links must see the same names on every platform.
CASE_SENSE_NAMES       = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

#---------------------------------------------------------------------------
# What gets documented
#---------------------------------------------------------------------------
# The library is C, so there are no classes; "members" are functions, macros,
# typedefs and struct fields.
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES          # file-static helpers carry the real algorithms
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_SCOPE_NAMES       = YES
SHOW_INCLUDE_FILES     = YES
SHOW_HEADERFILE        = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = NO
FORCE_LOCAL_INCLUDES   = NO
INLINE_INFO            = YES
SORT_MEMBER_DOCS       = NO           # declaration order carries meaning here
SORT_BRIEF_DOCS        = NO
SORT_MEMBERS_CTORS_1ST = NO
SORT_GROUP_NAMES       = NO
SORT_BY_SCOPE_NAME     = NO
STRICT_PROTO_MATCHING  = NO
GENERATE_TODOLIST      = YES
GENERATE_TESTLIST      = YES
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST= YES
MAX_INITIALIZER_LINES  = 30
SHOW_GROUPED_MEMB_INC  = NO

# Brief descriptions are written with @brief; do not also steal the first line.
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
INHERIT_DOCS           = YES
SEPARATE_MEMBER_PAGES  = NO
TAB_SIZE               = 2
INLINE_SIMPLE_STRUCTS  = NO
TYPEDEF_HIDES_STRUCT   = YES          # `typedef struct MFTL_X {...} MFTL_X;`

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
# The library's own trees, plus the measurement document it keeps next to the
# code it measures -- it is cited by ~50 source comments there, so it stays with
# the library and is read from here. That document is OPTIONAL (MFTL2 keeps
# docs/ out of its repository): mftl_paths.measurement_substitutions() fills
# MEASUREMENTS_INPUT with its path when it exists, and otherwise EXCLUDEs the
# Analysis page that introduces it, so neither dangles.
INPUT                  = @MFTL_DOCS_SOURCE_DIR@/include \
                         @MFTL_DOCS_SOURCE_DIR@/src \
                         @MFTL_DOCS_MEASUREMENTS_INPUT@ \
                         @MFTL_DOCS_DIR@/doxygen \
                         @MFTL_DOCS_DIR@/pages

INPUT_ENCODING         = UTF-8
RECURSIVE              = YES
FILE_PATTERNS          = *.c *.h *.md *.dox
EXCLUDE                = @MFTL_DOCS_MEASUREMENTS_EXCLUDE@
EXCLUDE_SYMLINKS       = NO
EXCLUDE_PATTERNS       = */build/* */external/*
EXCLUDE_SYMBOLS        =

# Strip both absolute prefixes, so a library path renders as `src/bvh/bvh_build.c`
# and a documentation path as `pages/architecture.md` -- neither carries the
# reader's home directory, and the two trees stay distinguishable.
STRIP_FROM_PATH        = @MFTL_DOCS_SOURCE_DIR@ \
                         @MFTL_DOCS_DIR@
# The `#include` line on a type's page: `mftl_types.h` for a public type,
# `topology_change/topo_internal.h` for an internal one -- without the second
# entry the latter carried the absolute path of whoever built the manual.
STRIP_FROM_INC_PATH    = @MFTL_DOCS_SOURCE_DIR@/include \
                         @MFTL_DOCS_SOURCE_DIR@/src

EXAMPLE_PATH           = @MFTL_DOCS_SOURCE_DIR@/examples \
                         @MFTL_DOCS_SOURCE_DIR@/tests
EXAMPLE_PATTERNS       = *
EXAMPLE_RECURSIVE      = YES
IMAGE_PATH             = @MFTL_DOCS_DIR@/images

#---------------------------------------------------------------------------
# Markdown and the theory pages
#---------------------------------------------------------------------------
MARKDOWN_SUPPORT       = YES
MARKDOWN_ID_STYLE      = DOXYGEN

# Doxygen's default is to absorb a directory's README.md into that DIRECTORY's
# documentation rather than making it a page. The module READMEs here are full
# theory chapters that the manual links to with @subpage, so they have to be
# pages -- with IMPLICIT_DIR_DOCS left on, their {#mftl_mod_*} labels do not
# exist and every reference to them dangles.
IMPLICIT_DIR_DOCS      = NO
TOC_INCLUDE_HEADINGS   = 4
AUTOLINK_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = @MFTL_DOCS_DIR@/pages/mainpage.md

# The module READMEs are read on GitHub as well as here, so they carry LaTeX in
# the GitHub dialect (`$ ... $`, `$$ ... $$`). Doxygen understands only
# `\f$ ... \f$`. This filter rewrites one into the other on the way in, so a
# single source serves both readers -- see doxygen/md_math_filter.py, which
# is careful to leave code spans and fenced blocks alone.
FILTER_PATTERNS        = "*.md=python3 @MFTL_DOCS_DIR@/doxygen/md_math_filter.py"
FILTER_SOURCE_FILES    = NO

#---------------------------------------------------------------------------
# Source browsing -- the prose in this library lives next to the code, so the
# annotated sources are a first-class part of the manual rather than a dump.
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
SOURCE_TOOLTIPS        = YES
USE_HTAGS              = NO
VERBATIM_HEADERS       = YES
CLANG_ASSISTED_PARSING = NO

#---------------------------------------------------------------------------
# Preprocessing
#
# The pools, the iterators and the flag word are macros, so the preprocessor has
# to run -- but it must NOT expand them away, or the documentation loses exactly
# what it is documenting.  MACRO_EXPANSION = NO keeps every macro visible as a
# documented entity; PREDEFINED then supplies the few symbols that would
# otherwise make the parser take the wrong branch.
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = @MFTL_DOCS_SOURCE_DIR@/include
INCLUDE_FILE_PATTERNS  = *.h
PREDEFINED             = __STDC_VERSION__=201112L \
                         MFTL_ASSERT(x)= \
                         _Static_assert(x,y)= \
                         restrict= \
                         DOXYGEN_SHOULD_SKIP_THIS
SKIP_FUNCTION_MACROS   = NO

#---------------------------------------------------------------------------
# Aliases -- shorthands used throughout the MFTL comments
#---------------------------------------------------------------------------
ALIASES               += collective="@par Collective:^^ Must be called by **every rank** of the ensemble's communicator."
ALIASES               += rank_local="@par Rank-local:^^ Performs **no** MPI. Each rank operates on its own partition."
ALIASES               += invariant{1}="@par Invariant:^^ \1"
ALIASES               += complexity{1}="@par Complexity:^^ \1"
ALIASES               += measured{1}="@par Measured:^^ \1"
ALIASES               += theory{1}="@par Theory:^^ \1"
ALIASES               += silentfailure{1}="@warning **Silent when wrong.** \1"

#---------------------------------------------------------------------------
# LaTeX formulas in HTML, rendered natively by MathJax 3
#---------------------------------------------------------------------------
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
MATHJAX_FORMAT         = HTML-CSS
MATHJAX_RELPATH        = https://cdn.jsdelivr.net/npm/mathjax@3
MATHJAX_EXTENSIONS     = ams
MATHJAX_CODEFILE       = @MFTL_DOCS_DIR@/doxygen/mathjax.js
FORMULA_FONTSIZE       = 10
FORMULA_MACROFILE      = @MFTL_DOCS_DIR@/doxygen/formulas.tex

#---------------------------------------------------------------------------
# HTML output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_HEADER            =
HTML_FOOTER            =
HTML_STYLESHEET        =
HTML_EXTRA_STYLESHEET  = @MFTL_DOCS_DIR@/doxygen/mftl.css
HTML_EXTRA_FILES       =
HTML_COLORSTYLE        = TOGGLE
HTML_COLORSTYLE_HUE    = 209
HTML_COLORSTYLE_SAT    = 120
HTML_COLORSTYLE_GAMMA  = 85
HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = NO
HTML_CODE_FOLDING      = YES
HTML_COPY_CLIPBOARD    = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
TREEVIEW_WIDTH         = 300
ENUM_VALUES_PER_LINE   = 1
DISABLE_INDEX          = NO
LAYOUT_FILE            = @MFTL_DOCS_DIR@/doxygen/DoxygenLayout.xml

SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
EXTERNAL_SEARCH        = NO

#---------------------------------------------------------------------------
# Other output formats -- off by default; the HTML manual is the deliverable.
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO
GENERATE_AUTOGEN_DEF   = NO
GENERATE_SQLITE3       = NO

# LaTeX settings, so that -DMFTL_DOCS_LATEX=ON produces a usable PDF.
LATEX_OUTPUT           = latex
LATEX_CMD_NAME         =
MAKEINDEX_CMD_NAME     = makeindex
LATEX_MAKEINDEX_CMD    = makeindex
COMPACT_LATEX          = NO
PAPER_TYPE             = a4
EXTRA_PACKAGES         = amsmath amssymb booktabs
PDF_HYPERLINKS         = YES
USE_PDFLATEX           = YES
LATEX_BATCHMODE        = YES
LATEX_HIDE_INDICES     = NO
LATEX_BIB_STYLE        = plain
LATEX_EMOJI_DIRECTORY  =

#---------------------------------------------------------------------------
# Graphviz -- call graphs, caller graphs and the #include dependency graphs
#---------------------------------------------------------------------------
HAVE_DOT               = @MFTL_DOCS_HAVE_DOT@
DOT_PATH               = @MFTL_DOCS_DOT_PATH@
DOT_NUM_THREADS        = 0
DOT_COMMON_ATTR        = "fontname=Helvetica,fontsize=10"
DOT_EDGE_ATTR          = "labelfontname=Helvetica,labelfontsize=10"
DOT_NODE_ATTR          = "shape=box,height=0.2,width=0.4"

CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DIR_GRAPH_MAX_DEPTH    = 3

INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

# SVG keeps a 60-node call graph legible; INTERACTIVE_SVG adds pan/zoom so the
# big ones (MFTLRemeshEnsembleParallel, MFTLRedistributeWithOwners) are
# actually readable rather than merely present.
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_TRANSPARENT        = NO
DOT_MULTI_TARGETS      = YES
DOT_GRAPH_MAX_NODES    = 160
MAX_DOT_GRAPH_DEPTH    = 0
DOT_CLEANUP            = YES

#---------------------------------------------------------------------------
# Warnings -- the documentation is treated as code that has to compile.
#---------------------------------------------------------------------------
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_IF_UNDOC_ENUM_VAL = YES
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LINE_FORMAT       = "at line $line of file $file"
WARN_LOGFILE           = @MFTL_DOCS_OUTPUT_DIR@/doxygen-warnings.log
